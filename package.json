{
    "name": "prompt-analizer",
    "version": "0.1.0",
    "description": "Deterministic, zero-AI-call prompt analyzer and validator for LLMs, tuned for Spanish and bilingual (ES/EN) inputs.",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:module": "pnpm build && node scripts/test-analyzer.mjs",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "clean": "rm -rf dist"
    },
    "keywords": [
        "llm",
        "prompt",
        "analyzer",
        "validator",
        "guardrails",
        "spanish",
        "prompt-injection",
        "pii",
        "security",
        "typescript"
    ],
    "license": "MIT",
    "engines": {
        "node": ">=20.0.0"
    },
    "packageManager": "pnpm@12.16.1",
    "dependencies": {
        "js-tiktoken": "^1.0.21"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.10.0",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.14.0",
        "prettier": "^3.10.1",
        "tsup": "^8.3.5",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.72.2",
        "vitest": "^2.1.8"
    }
}
